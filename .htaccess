# Настройки Apache для сайта. Этот файл ЗАГРУЖАЕТСЯ на хостинг вместе с сайтом.

AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https. Вторая строка нужна, если хостинг стоит за своим прокси.
  # Если после загрузки сайт уйдёт в бесконечную переадресацию — удалите эти 3 строки.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www.DOMAIN -> DOMAIN (основной адрес сайта — без www)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html -> / (один адрес главной страницы для поисковиков)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

# Служебное не отдаём (404):
#  - всё, что начинается с точки (.git, .DS_Store, .gitignore …), кроме .well-known (нужна для SSL-сертификата);
#  - папки в корне, начинающиеся с подчёркивания (_НЕ_ЗАГРУЖАТЬ, _lead_ratelimit);
#  - заметки, архивы и резервные копии.
RedirectMatch 404 /\.(?!well-known/)
RedirectMatch 404 ^/_
RedirectMatch 404 (?i)\.(md|zip|rar|7z|bak|old|orig|swp|log|sql)$
RedirectMatch 404 ~$

# Файл с токеном бота по прямой ссылке не отдаём (PHP всё равно может его подключать)
<IfModule mod_authz_core.c>
  <Files "lead-config.php">
    Require all denied
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  <Files "lead-config.php">
    Order allow,deny
    Deny from all
  </Files>
</IfModule>

# Заголовки безопасности
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Типы файлов
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddCharset UTF-8 .txt .xml .webmanifest

# Сжатие (скорость загрузки — фактор ранжирования)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json application/ld+json application/manifest+json image/svg+xml
</IfModule>

# Кэширование. CSS/JS подключены с ?v=N — при изменении меняйте номер версии в HTML.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
</IfModule>
